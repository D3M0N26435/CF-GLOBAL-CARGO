# Completa valores públicos aquí o copia este archivo a .env para tu configuración local.
# Antes de publicar, ejecuta: node scripts/generate-public-config.mjs
# Si existe .env, sus valores tienen prioridad. El generador solo publica estas URLs y números; nunca copies tokens privados aquí.

# Redes sociales de la cabecera
SOCIAL_TIKTOK_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_WHATSAPP_URL=

# Invitaciones de comunidades
WHATSAPP_GROUP_CHINA_URL=
WHATSAPP_GROUP_CHILE_URL=

# Destinatarios de solicitudes de cotización. Usa formato internacional, solo dígitos.
# Sin +, espacios ni guiones. Ejemplo de formato Bolivia: 59170000000
WHATSAPP_QUOTE_RECIPIENT_1=
WHATSAPP_QUOTE_RECIPIENT_2=

# Firebase web config (los valores actuales del proyecto siguen en js/firebase-config.js)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudinary (configuración pública para subida sin firma)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
