# Copia este archivo a .env y completa los enlaces y teléfonos.
# Antes de publicar, ejecuta: node scripts/generate-public-config.mjs
# El generador solo publica estas URLs y números; nunca copies tokens privados aquí.

# Redes sociales de la cabecera
SOCIAL_TIKTOK_URL=https://www.tiktok.com/@cf.globalcargo.imp?_r=1&_t=ZS-9ATqnmB4rQH
SOCIAL_FACEBOOK_URL=https://www.facebook.com/share/18QPVKNjCC/
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/cf_global_cargo?utm_source=qr&xtok=Mng2OWFmNThxNW1p
SOCIAL_WHATSAPP_URL=

# Invitaciones de comunidades
WHATSAPP_GROUP_CHINA_URL=
WHATSAPP_GROUP_CHILE_URL=

# Destinatarios de solicitudes de cotización. Usa formato internacional, solo dígitos.
# Sin +, espacios ni guiones. Ejemplo de formato Bolivia: 59170000000
WHATSAPP_QUOTE_RECIPIENT_1=
WHATSAPP_QUOTE_RECIPIENT_2=

# Firebase web config (los valores actuales del proyecto siguen en js/firebase-config.js)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudinary (configuración pública para subida sin firma)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
